name: Build Vulkan Loader cho iOS

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Cài đặt công cụ
        run: |
          brew install cmake ninja

      - name: Tải Vulkan-Loader
        run: |
          git clone --branch v1.3.296 https://github.com/KhronosGroup/Vulkan-Loader.git
          git clone --branch v1.3.296 https://github.com/KhronosGroup/Vulkan-Headers.git

      - name: Build Loader cho iOS
        run: |
          IOS_SDK=$(xcrun --sdk iphoneos --show-sdk-path)
          cd Vulkan-Loader
          mkdir build && cd build
          cmake .. \
            -DCMAKE_SYSTEM_NAME=iOS \
            -DCMAKE_OSX_ARCHITECTURES=arm64 \
            -DCMAKE_OSX_SYSROOT=$IOS_SDK \
            -DVULKAN_HEADERS_INSTALL_DIR=${{ github.workspace }}/Vulkan-Headers \
            -DBUILD_TESTS=OFF \
            -DENABLE_WERROR=OFF \
            -DBUILD_SHARED_LIBS=ON
          make -j$(sysctl -n hw.ncpu)

      - name: Xuất file dylib
        uses: actions/upload-artifact@v4
        with:
          name: libvulkan-ios
          path: Vulkan-Loader/build/loader/libvulkan.1.dylib
